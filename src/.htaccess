# Apache / cPanel — upload together with the build into the /driver/ folder.
Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /driver/

  # Real files and folders are served as they are
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Every other path (e.g. /driver/orders on refresh) is handled by Angular
  RewriteRule ^ index.html [L]
</IfModule>

AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  # Never cache the entry files, otherwise drivers keep running an old build
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Hashed bundles never change, so they can be cached for a year
  <FilesMatch "\.[0-9a-f]{16,}\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
